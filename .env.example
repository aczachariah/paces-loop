# Database Configuration (Future PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paces_loop?schema=public"

# NextAuth / Authentication (Future)
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Signed exam transcripts (REQUIRED in production)
# Generate an independent random secret of at least 32 characters, e.g. `openssl rand -hex 32`.
# Never commit the production value. Configure it in the deployment environment.
EXAM_SESSION_SECRET="local-development-only-secret-change-me"

# LLM provider credentials (server-only; configure locally or in deployment)
ENGY_API_KEY=""
SAYGM_API_KEY=""

# Application Environment
NODE_ENV="development"
PORT=3000
