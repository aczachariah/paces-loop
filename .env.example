# Database Configuration (Future PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paces_loop?schema=public"

# NextAuth / Authentication (Future)
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Signed exam transcripts (REQUIRED outside development/test)
# Generate an independent random secret of at least 32 characters: `openssl rand -hex 32`.
# The placeholder below is deliberately rejected; the server refuses to start with it
# (or with no/short value) unless NODE_ENV is development or test. In development, a
# missing or placeholder value falls back to a random per-process secret.
# Never commit the real value. Configure it in the deployment environment.
EXAM_SESSION_SECRET="replace-with-output-of-openssl-rand-hex-32"

# Pilot access code (REQUIRED outside development/test)
# Every AI-backed route requires this value in the x-paces-access-code header; candidates
# enter it on the pilot overview page. If unset in production, AI routes return 503.
# Leave empty for local development to keep the routes open.
PACES_ACCESS_CODE=""

# LLM provider credentials (server-only; configure locally or in deployment)
ENGY_API_KEY=""
SAYGM_API_KEY=""

# Application Environment
NODE_ENV="development"
PORT=3000
